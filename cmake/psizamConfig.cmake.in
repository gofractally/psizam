@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
find_dependency(Boost)
find_dependency(psio 0.1 CONFIG)
include("${CMAKE_CURRENT_LIST_DIR}/psizamTargets.cmake")
if("LLVM" IN_LIST psizam_FIND_COMPONENTS)
  if(@PSIZAM_ENABLE_LLVM@)
    find_dependency(LLVM CONFIG)
    include("${CMAKE_CURRENT_LIST_DIR}/psizamLLVMTargets.cmake")
    set(psizam_LLVM_FOUND TRUE)
  else()
    set(psizam_LLVM_FOUND FALSE)
  endif()
endif()
check_required_components(psizam)
