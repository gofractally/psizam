(module
  (type $small (func (param i32) (result i64)))
  (type $large (func (param i64 i32 f64 i64) (result i64)))
  (import "env" "host" (func $host (param i64 i32) (result i64)))
  (import "env" "sample" (func $sample))
  (memory 1)
  (table 4 funcref)
  (table 2 funcref)
  (elem (i32.const 0) $small $large $host)
  (elem (table 1) (i32.const 0) $large $small)

  (func $sum (param i64 i32) (result i64)
    (i64.add (local.get 0) (i64.extend_i32_u (local.get 1))))
  (func $vector (param i32) (result v128)
    (v128.const i64x2 0x0123456789abcdef 0xfedcba9876543210))
  (func $multi (param i32) (result i32 i64)
    (local.get 0) (i64.const 0xfedcba9876543210))
  (func $bits (param f64) (result i64)
    (i64.reinterpret_f64 (local.get 0)))
  (func (export "ordinary") (result i64)
    (i64.add (i64.const 101)
      (i64.add (call $sum (i64.const 1000) (i32.const 23))
        (call $host (i64.const 2000) (i32.const 31)))))
  (func (export "ordinary_indirect") (result i64)
    (i64.add (i64.const 101)
      (call_indirect (type $small) (i32.const 0) (i32.const 0))))
  (func (export "ordinary_vector") (result i64)
    (i64.add (i64.const 101)
      (i64x2.extract_lane 1 (call $vector (i32.const 23)))))
  (func (export "ordinary_multi") (result i64) (local i64)
    (call $multi (i32.const 23)) (local.set 0) (drop)
    (i64.add (local.get 0) (i64.const 101)))
  (func (export "ordinary_bits") (param i64) (result i64)
    (call $bits (f64.reinterpret_i64 (local.get 0))))

  (func $small (type $small) (param $n i32) (result i64)
    (call $sample)
    (if (result i64) (i32.eqz (local.get $n))
      (then (i64.const 0x123456789abcdef))
      (else
        (return_call $large (i64.const 0x102030405060708)
          (i32.sub (local.get $n) (i32.const 1))
          (f64.const -0) (i64.const 0x8877665544332211)))))
  (func $large (type $large) (param i64) (param $n i32) (param f64 i64) (result i64)
    (if (i64.ne (local.get 0) (i64.const 0x102030405060708)) (then unreachable))
    (if (i64.ne (i64.reinterpret_f64 (local.get 2)) (i64.const 0x8000000000000000)) (then unreachable))
    (if (i64.ne (local.get 3) (i64.const 0x8877665544332211)) (then unreachable))
    (return_call $small (local.get $n)))
  (func (export "cycle") (param i32) (result i64)
    (i64.add (i64.const 101) (call $small (local.get 0))))
)
