(module
  (type $small (func (param i32) (result i64)))
  (type $large (func (param i64 i32 f64 i64) (result i64)))
  (type $host_type (func (param i64 i32) (result i64)))
  (import "env" "host" (func $host (param i64 i32) (result i64)))
  (import "env" "sample" (func $sample))
  (memory 1)
  (global $fail (mut i32) (i32.const 0))
  (table 6 funcref)
  (table 2 funcref)
  (elem (i32.const 0) $small $large $host $small_indirect $large_indirect)
  (elem (table 1) (i32.const 0) $large $small_indirect)

  (func $sum (param i64 i32) (result i64)
    (i64.add (local.get 0) (i64.extend_i32_u (local.get 1))))
  (func $vector (param i32) (result v128)
    (v128.const i64x2 0x0123456789abcdef 0xfedcba9876543210))
  (func $multi (param i32) (result i32 i64)
    (local.get 0) (i64.const 0xfedcba9876543210))
  (func $bits (param f64) (result i64)
    (i64.reinterpret_f64 (local.get 0)))
  (func (export "ordinary") (result i64)
    (i64.add (i64.const 101)
      (i64.add (call $sum (i64.const 1000) (i32.const 23))
        (call $host (i64.const 2000) (i32.const 31)))))
  (func (export "ordinary_indirect") (result i64)
    (i64.add (i64.const 101)
      (call_indirect (type $small) (i32.const 0) (i32.const 0))))
  (func (export "ordinary_vector") (result i64)
    (i64.add (i64.const 101)
      (i64x2.extract_lane 1 (call $vector (i32.const 23)))))
  (func (export "ordinary_multi") (result i64) (local i64)
    (call $multi (i32.const 23)) (local.set 0) (drop)
    (i64.add (local.get 0) (i64.const 101)))
  (func (export "ordinary_bits") (param i64) (result i64)
    (call $bits (f64.reinterpret_i64 (local.get 0))))

  (func $small (type $small) (param $n i32) (result i64)
    (call $sample)
    (if (result i64) (i32.eqz (local.get $n))
      (then
        (if (result i64) (global.get $fail)
          (then unreachable) (else (i64.const 0x123456789abcdef))))
      (else
        (return_call $large (i64.const 0x102030405060708)
          (i32.sub (local.get $n) (i32.const 1))
          (f64.const -0) (i64.const 0x8877665544332211)))))
  (func $large (type $large) (param i64) (param $n i32) (param f64 i64) (result i64)
    (if (i64.ne (local.get 0) (i64.const 0x102030405060708)) (then unreachable))
    (if (i64.ne (i64.reinterpret_f64 (local.get 2)) (i64.const 0x8000000000000000)) (then unreachable))
    (if (i64.ne (local.get 3) (i64.const 0x8877665544332211)) (then unreachable))
    (return_call $small (local.get $n)))
  (func (export "cycle") (param i32) (result i64)
    (i64.add (i64.const 101) (call $small (local.get 0))))
  (export "small" (func $small))
  (export "large" (func $large))

  (func $small_indirect (type $small) (param $n i32) (result i64)
    (call $sample)
    (if (result i64) (i32.eqz (local.get $n))
      (then (i64.const 0x123456789abcdef))
      (else
        (return_call_indirect (type $large)
          (i64.const 0x102030405060708)
          (i32.sub (local.get $n) (i32.const 1))
          (f64.const -0) (i64.const 0x8877665544332211) (i32.const 4)))))
  (func $large_indirect (type $large) (param i64) (param $n i32) (param f64 i64) (result i64)
    (if (i64.ne (local.get 0) (i64.const 0x102030405060708)) (then unreachable))
    (if (i64.ne (i64.reinterpret_f64 (local.get 2)) (i64.const 0x8000000000000000)) (then unreachable))
    (if (i64.ne (local.get 3) (i64.const 0x8877665544332211)) (then unreachable))
    (return_call_indirect 1 (type $small) (local.get $n) (i32.const 1)))
  (func (export "cycle_indirect") (param i32) (result i64)
    (i64.add (i64.const 101) (call $small_indirect (local.get 0))))
  (func (export "host_tail") (param i32) (result i64)
    (return_call $host (i64.const 1000) (local.get 0)))
  (func (export "host_indirect_tail") (param i32) (result i64)
    (return_call_indirect (type $host_type) (i64.const 1000) (local.get 0) (i32.const 2)))
  (func (export "indirect_bad") (param i32) (result i64)
    (return_call_indirect (type $small) (i32.const 0) (local.get 0)))
  (func (export "set_fail") (param i32) (global.set $fail (local.get 0)))
  (func (export "set_tail") (param i32) (result i64)
    (table.set (i32.const 5) (ref.func $small))
    (return_call_indirect (type $small) (local.get 0) (i32.const 5)))
  (func (export "fill_tail") (param i32) (result i64)
    (table.fill (i32.const 5) (ref.func $small) (i32.const 1))
    (return_call_indirect (type $small) (local.get 0) (i32.const 5)))
  (func (export "grow_tail") (param i32) (result i64) (local i32)
    (local.set 1 (table.grow (ref.func $small) (i32.const 1)))
    (return_call_indirect (type $small) (local.get 0) (local.get 1)))
  (func (export "set_import_tail") (param i32) (result i64)
    (table.set (i32.const 5) (ref.func $host))
    (return_call_indirect (type $host_type) (i64.const 1000) (local.get 0) (i32.const 5)))
  (func (export "grow_import_tail") (param i32) (result i64) (local i32)
    (local.set 1 (table.grow (ref.func $host) (i32.const 1)))
    (return_call_indirect (type $host_type) (i64.const 1000) (local.get 0) (local.get 1)))
  (func (export "set_secondary_tail") (param i32) (result i64)
    (table.set 1 (i32.const 0) (ref.func $small))
    (return_call_indirect 1 (type $small) (local.get 0) (i32.const 0)))

  (func $vector_small (param $n i32) (param $v v128) (result v128)
    (if (result v128) (i32.eqz (local.get $n))
      (then (local.get $v))
      (else (return_call $vector_large (i64.const 123)
        (local.get $v) (i32.sub (local.get $n) (i32.const 1))
        (v128.const i64x2 0xaaaaaaaaaaaaaaaa 0x5555555555555555)))))
  (func $vector_large (param i64 v128 i32 v128) (result v128)
    (if (i64.ne (local.get 0) (i64.const 123)) (then unreachable))
    (if (i64.ne (i64x2.extract_lane 0 (local.get 3)) (i64.const 0xaaaaaaaaaaaaaaaa)) (then unreachable))
    (if (i64.ne (i64x2.extract_lane 1 (local.get 3)) (i64.const 0x5555555555555555)) (then unreachable))
    (return_call $vector_small (local.get 2) (local.get 1)))
  (func (export "vector_tail") (param i32) (result i64) (local v128)
    (local.set 1 (call $vector_small (local.get 0)
      (v128.const i64x2 0x0123456789abcdef 0xfedcba9876543210)))
    (i64.xor (i64x2.extract_lane 0 (local.get 1)) (i64x2.extract_lane 1 (local.get 1))))
  (func $multi_small (param i32) (result i32 i64)
    (if (result i32 i64) (i32.eqz (local.get 0))
      (then (i32.const 23) (i64.const 0xfedcba9876543210))
      (else (return_call $multi_large (i64.const 123) (i32.sub (local.get 0) (i32.const 1))))))
  (func $multi_large (param i64 i32) (result i32 i64)
    (if (i64.ne (local.get 0) (i64.const 123)) (then unreachable))
    (return_call $multi_small (local.get 1)))
  (func (export "multi_tail") (param i32) (result i64) (local i64 i32)
    (call $multi_small (local.get 0)) (local.set 1) (local.set 2)
    (i64.xor (local.get 1) (i64.extend_i32_u (local.get 2))))
)
